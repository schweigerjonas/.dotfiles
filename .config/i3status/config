general {
    colors = true
    interval = 5
}

order += "cpu_usage"
order += "memory"
order += "battery all"
order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "tztime local"

cpu_usage {
    format = "CPU: %usage"
}

memory {
    format = "RAM: %used / %total"
}

battery all {
    format = "BAT: %percentage %status"
    path = "/sys/class/power_supply/BAT%d/uevent"
}

wireless _first_ {
    format_up = "W: %essid - %quality"
    format_down = "W: down"
}

ethernet _first_ {
    format_up = "E: online"
    format_down = "E: offline"
}

volume master {
    format = "VOL: %volume"
    device = "pulse"
}

tztime local {
    format = "%a %d, %b %H:%M"
}
